<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PurchaseKMP" parent="Theme.Material3.Dark.NoActionBar">
        <!-- App brand colors -->
        <item name="colorPrimary">#38A186</item>
        <item name="colorPrimaryVariant">#2D8A70</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#4ACFAC</item>
        <item name="colorOnSecondary">#000000</item>

        <!-- Dark window background — eliminates white flash between screens -->
        <item name="android:windowBackground">#FF121212</item>
        <item name="android:colorBackground">#FF121212</item>

        <!-- Edge-to-edge: let Compose handle status/nav bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen theme — shows dark bg before first frame -->
    <style name="Theme.PurchaseKMP.Splash" parent="Theme.PurchaseKMP">
        <item name="android:windowBackground">#FF121212</item>
    </style>
</resources>

